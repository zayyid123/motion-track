# Optional HTTP toggle (default: enabled). Set AI_PROXY_ALLOW_HTTP=0 to restrict to HTTPS only.
# WARNING: plain HTTP sends the API key and response unencrypted between server and host.
# AI_PROXY_ALLOW_HTTP=1

# Google Analytics 4 measurement ID (optional). When unset or empty, GA4 is not
# loaded at all and the app makes no third-party requests.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
